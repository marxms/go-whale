# GoWhale environment overrides. This file is a reference: it is NOT loaded
# automatically. Export the variables in your shell or Compose environment.
# Every variable is optional unless noted; the empty values are local defaults.

GOWHALE_CONFIG_FILE=./config.yaml

# Binance WebSocket hosts (optional overrides). Production hosts only: the
# testnet is not used in any environment.
# GOWHALE_BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
# GOWHALE_BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443

# Redis (required for normal operation)
GOWHALE_REDIS_ADDR=localhost:6379
GOWHALE_REDIS_PASSWORD=
GOWHALE_REDIS_DB=0

# QuestDB (PostgreSQL wire protocol)
GOWHALE_QUESTDB_PG_PASSWORD=

# Realtime WebSocket (opt-in). Set BOTH secrets to at least 32 random bytes and
# an explicit browser origin; the authenticating gateway must inject the mint
# token as X-Gowhale-Mint-Token on /api/ws-ticket. Empty secrets disable the edge.
# Generate with: openssl rand -base64 32
# GOWHALE_REALTIME_WS_TICKET_SECRET=
# GOWHALE_REALTIME_WS_MINT_TOKEN=
# GOWHALE_REALTIME_WS_ALLOWED_ORIGINS=https://app.example.com
GOWHALE_REALTIME_WS_AUTH_DISABLED=false
# GOWHALE_REALTIME_WS_MAX_CONNECTIONS=4096
# GOWHALE_REALTIME_WS_MAX_SCOPES_PER_CONNECTION=128

# Logging
GOWHALE_LOG_LEVEL=info
GOWHALE_LOG_FORMAT=text
